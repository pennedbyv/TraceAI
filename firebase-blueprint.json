{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile document isolated to the authenticated user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Authenticated Firebase user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation ISO timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last sign-in ISO timestamp" }
      },
      "required": ["uid", "createdAt", "lastLoginAt"]
    },
    "entries": {
      "title": "JournalEntry",
      "description": "Private notebook journal entries written by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Entry unique identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "title": { "type": "string", "description": "Entry title" },
        "content": { "type": "string", "description": "Manuscript body markdown/text" },
        "category": { "type": "string", "description": "Category: work or personal" },
        "tags": { "type": "array", "description": "Tags list" },
        "wordCount": { "type": "number", "description": "Calculated word count" },
        "readingTimeMinutes": { "type": "number", "description": "Estimated reading time" },
        "location": { "type": "string", "description": "Geographic tag" },
        "weather": { "type": "string", "description": "Weather observation" },
        "reflectionTone": { "type": "string", "description": "Tone classification" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "title", "content", "category", "wordCount", "createdAt", "updatedAt"]
    },
    "interactions": {
      "title": "CompanionInteraction",
      "description": "Gemini AI companion interactions, prompts, summaries, and margin notes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Interaction ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "entryId": { "type": "string", "description": "Associated entry ID" },
        "command": { "type": "string", "description": "Companion command executed" },
        "prompt": { "type": "string", "description": "User prompt or context" },
        "response": { "type": "string", "description": "Companion output" },
        "modelUsed": { "type": "string", "description": "Gemini model version" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["id", "userId", "command", "prompt", "response", "modelUsed", "timestamp"]
    },
    "memories": {
      "title": "Memory",
      "description": "Cognitive rhythm milestones, decisions, and temporal flashbacks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Memory ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Memory title" },
        "synthesis": { "type": "string", "description": "Synthesized insight" },
        "sourceDate": { "type": "string", "description": "Historical date of origin" },
        "type": { "type": "string", "description": "Memory type tag" }
      },
      "required": ["id", "userId", "title", "synthesis", "sourceDate", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Authenticated user profile records"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "entries",
      "description": "Private notebook entries scoped to the user"
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "interactions",
      "description": "AI companion interaction logs"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "memories",
      "description": "Archival memories and milestones"
    }
  }
}
